    <Target Name="ASWUnitTests_VCL_Console:Make">
        <MSBuild Projects="..\..\console\rad370\ASWUnitTests_VCL_Console.cbproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="ASWUnitTests_VCL_GUI;ASWUnitTests_VCL_Console"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="ASWUnitTests_VCL_GUI:Clean;ASWUnitTests_VCL_Console:Clean"/>
